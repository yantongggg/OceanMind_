# OceanMind backend configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# ── Signal ingestion ─────────────────────────────────────────────────────
# golden = serve the curated synthetic demo dataset (offline, deterministic)
# live   = ingest real signals from GDELT + maritime RSS feeds
# Golden stays the fallback whenever live ingestion yields nothing, so the
# demo never depends on connectivity.
INGEST_MODE=golden

# How often the ingestion engine polls all sources, in seconds.
INGEST_INTERVAL_SEC=300

# ── Supabase (signal storage) ────────────────────────────────────────────
# Server-side secret key. Bypasses RLS — never expose to the frontend,
# never commit, rotate immediately if it leaks.
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# If unset or unreachable, the store degrades to in-memory and ingestion
# still works for the session — the demo never hard-fails on Supabase.

# ── Optional: Claude narration ───────────────────────────────────────────
# Generates plainEnglish / notImplied for live signals. Without it, template
# text is used. Numbers are always tool-calculated, never model-generated.
ANTHROPIC_API_KEY=
